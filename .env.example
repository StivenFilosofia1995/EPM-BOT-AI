# =============================================================================
# epm-wa-platform — variables de entorno
# =============================================================================
# Copia este archivo a `.env` y completa los valores. NUNCA commitees `.env`.
# Toda variable nueva se agrega aquí, con comentario, en el mismo commit
# que la introduce (CLAUDE.md §9).
# Las variables marcadas [OBLIGATORIA] hacen fallar el arranque si faltan.
# =============================================================================


# -----------------------------------------------------------------------------
# Aplicación
# -----------------------------------------------------------------------------

# [OBLIGATORIA] Entorno de ejecución: development | staging | production | test
ENVIRONMENT=

# Nombre lógico de la aplicación (aparece en OpenAPI y logs).
APP_NAME=epm-wa-platform

# Prefijo de la API versionada.
API_V1_PREFIX=/api/v1

# Nivel de log: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Orígenes permitidos por CORS, separados por coma. Restringir en producción.
CORS_ORIGINS=http://localhost:3000


# -----------------------------------------------------------------------------
# Base de datos (PostgreSQL gestionado por Supabase)
# -----------------------------------------------------------------------------

# Hay DOS identidades de conexión y no son intercambiables (ver docs/DATABASE.md §2):
#   - DATABASE_URL          -> rol `epm_app`, NO omite RLS. Runtime del backend.
#   - DATABASE_MIGRATION_URL -> rol `postgres`, con DDL. Solo Alembic y el seed.
# Si el backend usara el rol de migraciones, las políticas de RLS no se
# aplicarían (ese rol tiene BYPASSRLS) y el aislamiento multitenant sería solo
# de aplicación.
#
# Usa el SESSION POOLER de Supabase, no la conexión directa: db.<ref>.supabase.co
# solo publica IPv6 y falla en redes o plataformas sin IPv6, Railway incluida.
#   host    aws-1-<región>.pooler.supabase.com
#   puerto  5432
#   usuario <rol>.<project-ref>   (no solo el nombre del rol)
# Percent-encodea los caracteres especiales de la contraseña: '+' es %2B,
# '@' es %40, ':' es %3A, '/' es %2F y '#' es %23. Un '+' literal se
# interpreta como espacio y la autenticación falla sin decir por qué.

# [OBLIGATORIA] DSN async de SQLAlchemy con el rol de aplicación.
# Formato: postgresql+asyncpg://USUARIO:CONTRASENA@HOST:5432/BASE
DATABASE_URL=

# DSN con privilegios de DDL. Si se omite, se reutiliza DATABASE_URL: sirve en
# local pero NUNCA en producción, porque anula el aislamiento por RLS.
DATABASE_MIGRATION_URL=

# Contraseña con la que la migración inicial crea o actualiza el rol `epm_app`.
# Debe coincidir con la que lleva DATABASE_URL. Generar con: openssl rand -hex 24
APP_DB_PASSWORD=

# Tamaño del pool de conexiones.
DATABASE_POOL_SIZE=10

# Volcar el SQL emitido al log. Solo para depuración local; jamás en producción.
DATABASE_ECHO=false


# -----------------------------------------------------------------------------
# Supabase (Auth, Storage, Realtime, RLS)
# -----------------------------------------------------------------------------

# URL del proyecto Supabase. Ej: https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Clave pública (anon). Es la única que puede llegar al navegador.
SUPABASE_ANON_KEY=

# Clave service_role: omite RLS. SOLO en el backend, JAMÁS en el frontend
# ni en variables NEXT_PUBLIC_* (CLAUDE.md §8).
SUPABASE_SERVICE_ROLE_KEY=


# -----------------------------------------------------------------------------
# Meta — WhatsApp Business Cloud API
# -----------------------------------------------------------------------------
# Solo API oficial de Meta. Prohibida cualquier librería no oficial
# (Baileys, whatsapp-web.js, QR...) — CLAUDE.md §1.

# ID de la app de Meta (Meta for Developers).
META_APP_ID=

# Secreto de la app. Se usa para verificar la firma HMAC SHA-256
# de la cabecera X-Hub-Signature-256 de cada webhook.
META_APP_SECRET=

# Token de verificación del webhook (hub.verify_token). Aleatorio de >=32 bytes
# y DISTINTO por entorno. Generar con: openssl rand -hex 32
META_VERIFY_TOKEN=

# Versión de la Graph API contra la que se llama.
META_GRAPH_API_VERSION=v21.0

# --- Número de pruebas (Meta for Developers → WhatsApp → Configuración de la API)
# Meta regala un número de pruebas por app. Sirve para desarrollo: solo puede
# escribir a hasta 5 destinatarios verificados a mano, y el número que ve quien
# recibe es de Meta, no de la Fundación. El número real de la Fundación llega
# con el Embedded Signup en P4.

# ID del número emisor. NO es el número de teléfono: es el identificador que
# Meta muestra debajo, y es lo que se usa para enviar y para resolver el tenant
# en el webhook (CLAUDE.md §3.4).
META_PHONE_NUMBER_ID=

# ID de la cuenta de WhatsApp Business (WABA) a la que pertenece ese número.
META_WABA_ID=

# Token de acceso. El que da la pantalla de configuración es TEMPORAL: caduca
# en 24 horas y sirve para probar. El permanente se genera con un usuario del
# sistema en la configuración del negocio, y se cifra en reposo (CLAUDE.md §4).
META_ACCESS_TOKEN=


# -----------------------------------------------------------------------------
# Proveedores de IA
# -----------------------------------------------------------------------------
# La lógica de negocio no conoce el proveedor: se accede vía AIProviderPort.
# Cambiar de proveedor debe ser solo cambiar esta variable (CLAUDE.md §2, ADR 004).

# Proveedor por defecto: anthropic | openai | gemini
DEFAULT_AI_PROVIDER=anthropic

# Clave de Anthropic (proveedor del piloto).
ANTHROPIC_API_KEY=

# Modelo de Anthropic para redactar las respuestas del bot.
ANTHROPIC_MODEL=claude-sonnet-5

# Clave de OpenAI (alternativa / fallback).
OPENAI_API_KEY=

# Clave de Google Gemini (alternativa / fallback).
GEMINI_API_KEY=


# -----------------------------------------------------------------------------
# Seguridad
# -----------------------------------------------------------------------------

# [OBLIGATORIA] Secreto de la aplicación (firma de sesiones y tokens internos).
# Mínimo 16 caracteres. Generar con: openssl rand -hex 32
APP_SECRET_KEY=

# Clave de cifrado en reposo de los tokens de larga duración de Meta
# (envelope encryption). La base de datos guarda solo un puntero `token_ref`,
# nunca el token en claro. Generar con: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Límite de peticiones por minuto aplicado al webhook, por tenant y por wa_id.
WEBHOOK_RATE_LIMIT_PER_MINUTE=60


# -----------------------------------------------------------------------------
# Redis (caché, rate limiting, cola de webhooks)
# -----------------------------------------------------------------------------

# [OBLIGATORIA] DSN de Redis. Con Docker Compose: redis://redis:6379/0
REDIS_URL=


# -----------------------------------------------------------------------------
# Infraestructura
# -----------------------------------------------------------------------------

# Puerto interno del backend (uvicorn).
BACKEND_PORT=8000

# Puerto interno del frontend (Next.js).
FRONTEND_PORT=3000

# Puerto que nginx publica en el host.
NGINX_PORT=80


# -----------------------------------------------------------------------------
# Observabilidad
# -----------------------------------------------------------------------------

# DSN de Sentry para reporte de errores. Vacío = desactivado.
SENTRY_DSN=

# Endpoint OTLP para trazas OpenTelemetry. Vacío = desactivado.
OTEL_EXPORTER_OTLP_ENDPOINT=


# -----------------------------------------------------------------------------
# Panel de administración (TEMPORAL — se elimina en P5)
# -----------------------------------------------------------------------------

# Token compartido que exigen las rutas de administración en la cabecera
# `X-Admin-Token`. NO es autenticación: no identifica a nadie ni tiene roles.
# Existe solo para que el panel no quede abierto entre P2B y P5, cuando entre
# la autenticación de Supabase con usuarios y roles reales.
#
# Si está vacío, las rutas de administración responden 503: un despliegue al
# que se le olvidó la variable no debe quedar abierto por omisión.
# Generar con: openssl rand -hex 24
ADMIN_API_TOKEN=

# Tenant que usa el panel mientras no hay sesión de usuario. En P5 se deducirá
# del usuario autenticado y esta variable desaparece.
DEFAULT_TENANT_SLUG=fundacion-epm

# --- Frontend (frontend/.env.local) ------------------------------------------
# El panel NO llama al backend directamente: pasa por el proxy de Next en
# /app/api/backend, que inyecta el token en el servidor. Por eso estas dos
# variables no llevan el prefijo NEXT_PUBLIC_ — si lo llevaran, el token
# acabaría en el JavaScript que descarga el navegador.
#
#   BACKEND_URL=http://127.0.0.1:8000
#   ADMIN_API_TOKEN=<el mismo valor de arriba>
