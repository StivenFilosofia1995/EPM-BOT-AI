# POC de Chatwoot — copia esto a .env (nunca commitees .env) y completa los
# valores. Fuente: .env.example oficial de chatwoot/chatwoot, recortado a lo
# mínimo para levantar una instancia local de prueba.

# Genera un valor largo y aleatorio, p. ej.: openssl rand -hex 64
SECRET_KEY_BASE=

# URL con la que vas a acceder desde el navegador del host (puerto remapeado
# a 3010 en docker-compose.yml de este POC para no chocar con el proyecto).
FRONTEND_URL=http://localhost:3010

# En true para poder crear la primera cuenta de administrador desde la UI.
# Vuelve a false una vez creada, si vas a dejar esto corriendo.
ENABLE_ACCOUNT_SIGNUP=true

RAILS_ENV=production
INSTALLATION_ENV=docker

# Postgres — cualquier password, es solo para el contenedor local.
POSTGRES_HOST=postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=

# Redis — cualquier password, es solo para el contenedor local.
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=
